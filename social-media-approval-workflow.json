      "parameters": {
        "promptType": "define",
        "text": "={{ $json.results[0].content }}",
        "options": {
          "systemMessage": "=\n=============================\nLesson Resources: Social Media Posting Automation\n=============================\n\n\nSummary Agent System prompt:\n\n#Role\nYou are an AI content analyzer and summarizer.\n\n#Task\nRead and comprehend the provided article text, then generate a concise and informative summary limited to 60 words.\n\n#Instructions:\n\n- Identify the core message of the article.\n- Extract and highlight key facts, statistics, or examples that support the main points.\n- Include significant conclusions or recommendations, if any.\n- Avoid fluff, filler, and introductory phrases like “This article is about.”\n- Ensure the summary is understandable even without reading the full article.\n- Maintain clarity, coherence, and stick to the 35-word limit.\n- Use precise and concise language to express the main ideas effectively.\n\n#Rules:\n\n- Do not exceed 60 words.\n- Do not repeat the title of the article.\n- Focus on main ideas, supporting evidence, and takeaways.\n- Summary must be informative, helpful, and direct.\n- Use active language; prioritize information by relevance.\n- Ensure the final output is ready for integration into a content summarization automation.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        240,
        272
      ],
      "id": "88eb33a2-bf79-4aa6-80de-a75e01a7a7c3",
      "name": "Summary Agent"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.output }}",
        "options": {
          "systemMessage": "\nImage Description Agent System Prompt:\n\n\nYou are an AI prompt engineer specialising in creating prompts that will be used to create images for an AI and Automation company social media account.\n\n1. You will receive text data about a topic or post. Analyse this text to identify key elements such as the subject, action, setting, and additional details.\n\n2. Use the information extracted from the text to fill in the following AI image generation prompt template:\n\n[subject], [action], [setting], [additional details].\nThe image must be natural, realistic, in 2018, style raw, 8K, taken on iPhone, --ar 16:9\n\n[subject] should be the main focus of the image, like a person, object, creature, or concept. Be as specific as possible.\n\n[action] should describe what the subject is doing using active, descriptive verbs.\n\n[setting] should paint a vivid picture of the location, background, or environment surrounding the subject.\n\n[additional details] can include extra elements to enhance the image, such as clothing, colours, lighting, composition, or artistic references.\n\n3. Always end the generated prompt with the exact phrase:\n\"The image must be natural, realistic, in 2018, style raw, 8K, taken on iPhone, --ar 16:9\"\n\n4. Ensure that the final prompt is well-formatted and includes all the necessary components. Avoid incomplete or poorly structured prompts.\n\n\n"
        }
      },
